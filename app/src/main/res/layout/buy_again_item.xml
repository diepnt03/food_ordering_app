<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="350dp"
        android:layout_height="87dp"
        app:cardCornerRadius="22dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_image_food"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                app:cardCornerRadius="5dp">

                <ImageView
                    android:id="@+id/img_food_again"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_popular_02" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/cv_image_food"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_food_name_again"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:text="Spacy fresh crab" />

                <TextView
                    android:id="@+id/tv_price_again"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="$ 35" />

            </LinearLayout>

            <TextView
                android:layout_marginRight="10dp"
                android:layout_marginTop="20dp"
                android:layout_alignParentEnd="true"
                android:padding="5dp"
                android:textColor="@color/white"
                android:background="@drawable/addtocartshape"
                android:id="@+id/btn_buy_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy Again"
                android:textSize="15dp"/>

        </RelativeLayout>


    </androidx.cardview.widget.CardView>

</RelativeLayout>